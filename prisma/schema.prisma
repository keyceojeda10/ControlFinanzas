/// Lo que los usuarios dicen que les falta o les molesta.
///
/// ⚠ SIN RELACIONES A PROPÓSITO. `organizationId` y `userId` van como texto
/// suelto: declararlas obligaría a tocar `Organization` y `User`, que son las
/// dos tablas de las que cuelga todo, para una campaña temporal. El panel de
/// administrador resuelve los nombres con una segunda consulta.
///
/// `texto` es SIEMPRE texto legible: si vino como nota de voz, aquí está la
/// transcripción y el audio queda en `archivos`. Eso es lo que permite el
/// sondeo — leer trescientos audios de uno en uno no es un sondeo.
model Sugerencia {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  rol            String // owner | cobrador — para saber quién pide qué
  texto          String   @db.Text
  fuente         String // escrito | voz
  archivos       String?  @db.Text // JSON: rutas dentro del almacén, fuera de la web
  createdAt      DateTime @default(now())

  /// ── QUÉ SE HIZO CON ELLA ──────────────────────────────────────────────────
  /// El banner trajo 7 sugerencias de 4 negocios en tres días y ninguna tenía
  /// dónde anotarse: la tabla solo guardaba lo que escribieron. Sin esto, saber
  /// cuáles quedaban por atender era volver a leerlas todas y acordarse — y la
  /// primera tanda se estuvo tres días sin contestar por eso.
  ///
  /// `nueva` sin tocar · `vista` leída · `hecha` construida o ya existía ·
  /// `descartada` no se va a hacer. Va como texto y no como enum de Prisma a
  /// propósito: un enum obliga a migrar la base para añadir un estado, y este
  /// campo lo va a leer una persona, no una regla de negocio.
  estado         String   @default("nueva")
  /// ⚠ ESTO LO LEE QUIEN ESCRIBIÓ LA SUGERENCIA, no es una nota privada.
  /// Nació como libreta del dueño y el 18 ago se cambió: «no se les puede
  /// contestar desde el banner, no por WhatsApp». Escribieron desde ahí, así
  /// que la respuesta tiene que volver por ahí — y no todos tienen el WhatsApp
  /// del dueño ni tienen por qué.
  respuesta      String?  @db.Text
  respondidaEn   DateTime?
  /// Cuándo la vio. Sirve para dejar de avisarle: una tarjeta que no se puede
  /// cerrar es la que la gente aprende a saltarse.
  respuestaVistaEn DateTime?

  @@index([organizationId])
  @@index([createdAt])
  @@index([estado])
}

/// ══ EL LIBRO DE PAGOS DEL SAAS ══════════════════════════════════════════════
///
/// Antes de esto no existía. `Suscripcion` es UNA fila por organización y
/// renovar la PISA: `activarPlanPagado` actualiza `montoCOP`, la fecha y el
/// `wompiTransactionId` de la fila que ya estaba. El pago del mes anterior
/// dejaba de existir, así que la pregunta «¿cuánto me entró este mes?» no tenía
/// respuesta posible — el dato nunca se guardó.
///
/// Aquí cada pago es una fila que ya no se toca nunca más. `Suscripcion` sigue
/// siendo el ESTADO (hasta cuándo tiene servicio); esto es el HISTORIAL.
///
/// ⚠ `origen` no es adorno. Las filas de marzo a agosto de 2026 se
/// reconstruyeron leyendo el texto de `AdminLog` (el monto venía escrito en la
/// frase), y van marcadas `reconstruido` para que nadie las confunda con las
/// que se registraron en vivo. Si algún día no cuadran, se sabe cuáles dudar.
///
/// ⚠ `gatewayId` es único: es la misma llave de idempotencia que ya usaba el
/// webhook. En los pagos que se registran a mano va null —MySQL admite varios
/// nulls y cada registro manual ES un pago distinto, no un duplicado—, salvo en
/// los reconstruidos, que llevan `adminlog:<id>` para que volver a correr el
/// script no duplique nada.
model PagoSuscripcion {
  id             String   @id @default(cuid())
  organizationId String
  plan           Plan
  montoCOP       Int
  periodo        String // mensual | trimestral | anual
  gateway        String // wompi | mercadopago | manual
  gatewayId      String? @unique
  referencia     String?
  adminId        String? // quién lo registró, cuando fue a mano
  origen         String   @default("directo") // directo | reconstruido
  fecha          DateTime @default(now())

  @@index([organizationId])
  @@index([fecha])
}

/// LO QUE SALE POR WHATSAPP, APUNTADO.
///
/// ⚠ NACIÓ DE NO PODER CONTESTAR «¿SE MANDÓ O NO?». El 28 de agosto quedó la
/// duda de si un envío a 36 organizaciones había salido, y no había forma de
/// saberlo: `sendTemplate` no dejaba rastro en ninguna parte. Hicieron falta
/// una hora de forense, los registros del sistema y la analítica de Meta por
/// medias horas para concluir que NO había salido.
///
/// Se apunta en `postMessage`, que es el cuello por donde pasan TODOS los
/// envíos —plantillas y texto libre—, así que no hay forma de mandar algo por
/// fuera del registro.
///
/// Sin `organizationId`: quien manda no siempre sabe de qué organización es
/// —el bot escribe a leads que aún no son nadie— y el teléfono ya cruza con
/// todo. Añadirlo obligaría a tocar los veinte sitios que llaman.
model EnvioWhatsapp {
  id        String   @id @default(cuid())
  telefono  String
  tipo      String // template | texto
  plantilla String?
  wamid     String? // el id que asigna Meta; con él se cruzan los acuses de entrega
  ok        Boolean  @default(false)
  error     String?  @db.Text
  createdAt DateTime @default(now())

  @@index([telefono, createdAt])
  @@index([plantilla, createdAt])
  @@index([createdAt])
}
