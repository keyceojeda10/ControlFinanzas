// Control Finanzas - Schema de Prisma
// SaaS multi-tenant para gestión de cartera de crédito informal

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

generator clientLegacy {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─── ENUMS ───────────────────────────────────────────────

enum Plan {
  test
  starter
  basic
  growth
  standard
  professional
}

enum Rol {
  owner
  cobrador
  superadmin
}

enum EstadoCliente {
  activo
  mora
  cancelado
  inactivo
  eliminado
}

enum EstadoPrestamo {
  pendiente_aprobacion
  activo
  completado
  cancelado
}

enum TipoPago {
  completo
  parcial
  capital
  recargo
  descuento
  liquidacion
  intereses
}

enum EstadoSuscripcion {
  activa
  vencida
  cancelada
  pendiente
}

enum TipoSuscripcion {
  pago_unico
  recurrente
}

// ─── MODELOS ─────────────────────────────────────────────

model Organization {
  id                String         @id @default(cuid())
  nombre            String
  plan              Plan           @default(basic)
  telefono          String?
  ciudad            String?
  activo            Boolean        @default(true)
  codigoReferido    String?        @unique
  referidoPorId     String?
  descuento         Int            @default(0)
  cobradoresExtra   Int            @default(0)
  rutasExtra        Int            @default(0)
  // Cupo de clientes por encima del plan, para casos puntuales: el mismo patrón
  // que los dos de arriba. Sirve cuando a alguien se le prometió más de lo que
  // su plan da y no se le quiere forzar a subir de plan.
  clientesExtra     Int            @default(0)
  estadoContacto    EstadoContacto @default(nuevo)
  fuenteRegistro    String?
  planOriginal      Plan?
  planDemoHasta     DateTime?
  onboardingStep    Int            @default(0)
  onboardingFlujo   String?
  trialReminderSent Boolean        @default(false)
  recoveryEmailStep Int            @default(0)
  waRecoverySent    Boolean        @default(false)
  waOnboardingStep  Int            @default(0)
  waChurnSent       Boolean        @default(false)
  waActivacionSent  Boolean        @default(false)
  waPreVencSent     Boolean        @default(false)
  diasSinCobro      String?

  // ── «Cómo prestas por defecto» (Configuración) ──
  //
  // Lo que PRELLENA el formulario de nuevo préstamo. La advertencia del diseño
  // es parte del contrato: «cambiarlos aquí NO toca los préstamos que ya
  // existen». Nada que lea estos campos puede modificar un Prestamo creado.
  //
  // Nulos a propósito, no con `@default`: null significa «este negocio no ha
  // dicho cómo presta» y el formulario usa lo suyo de siempre. Un default en la
  // columna haría que 337 organizaciones existentes pareciera que eligieron
  // «diario al 20%» cuando ninguna lo hizo.
  frecuenciaDefault   String?      // diario | semanal | quincenal | mensual
  tasaDefault         Float?       // el % , con la semántica que fije modoInteresDefault
  modoInteresDefault  String?      // fijo | unico | solo_interes | saldo | ...

  capitalEstricto   Boolean        @default(false)
  capitalEsEfectivo Boolean        @default(false)
  // Vista BRUTA de renovaciones en la caja. Al renovar, el saldo viejo que se
  // "absorbe" no mueve efectivo, asi que por defecto no suma ni en Cobrado ni en
  // Prestado (vista NETA). Con esto en true se suma en AMBOS lados — como lo
  // esperan los prestamistas que piensan "recogi la cartulina vieja y presté una
  // nueva". El efectivo del dia es IDENTICO en las dos vistas; solo cambia si el
  // movimiento de la cartulina se ve o no. Ojo: sumarlo de un solo lado infla la caja.
  renovacionesEnCobrado Boolean    @default(false)
  // Meta de capital de la sociedad (estilo SAS). Si se fija, el % de cada socio
  // = su aporte neto / metaSociedad. Si es null/0, el % se calcula sobre el
  // total aportado por los socios. Es solo para el desglose de participacion;
  // NO cambia como se reparte hoy la ganancia (por prestamo asignado).
  metaSociedad      Float?
  modoAbreviado     Boolean        @default(false)
  ocultarSaldoWA    Boolean        @default(false)
  portalDatosCompletos Boolean      @default(false)
  camposRecibo      Json?
  plantillasWA      Json?
  requiereAprobacionPrestamos Boolean @default(false)
  ocultarCapitalCobradores    Boolean @default(false)
  tasaMoratorio     Float          @default(0)
  diasGraciaMoratorio Int          @default(5)
  country           String         @default("co")
  timezone          String?
  cartulinasHoy     Int            @default(0)
  cartulinasFecha   DateTime?
  createdAt         DateTime       @default(now())

  referidoPor        Organization?       @relation("Referidos", fields: [referidoPorId], references: [id])
  referidos          Organization[]      @relation("Referidos")
  users              User[]
  rutas              Ruta[]
  clientes           Cliente[]
  prestamos          Prestamo[]
  pagos              Pago[]
  cierresCaja        CierreCaja[]
  suscripciones      Suscripcion[]
  asistenteMemorias  AsistenteMemoria[]
  fotosDonadas       FotoDonada[]
  adminLogs          AdminLog[]
  gastosMenores      GastoMenor[]
  tickets            TicketSoporte[]
  notasSeguimiento   NotaSeguimiento[]
  leads              Lead[]
  botLeads           BotLead[]
  capital            Capital?
  movimientosCapital MovimientoCapital[]
  devengosInteres    DevengoInteres[]
  actividadLogs      ActividadLog[]
  gruposCobro        GrupoCobro[]
  festivos           Festivo[]
  visitasReagendadas VisitaReagendada[]
  lineasCredito      LineaCredito[]
  desembolsosLinea   DesembolsoLinea[]
  pagosLinea         PagoLinea[]
  cortesLinea        CorteLinea[]
  notificaciones     Notificacion[]
  socios             Socio[]
  aportesSocios      AporteSocio[]
  metodosPago        MetodoPago[]
  sesionesActivas    SesionActiva[]

  @@index([createdAt])
}

model User {
  id                      String    @id @default(cuid())
  organizationId          String?
  nombre                  String
  email                   String    @unique
  telefono                String?
  password                String
  rol                     Rol
  activo                  Boolean   @default(true)
  emailVerificado         Boolean   @default(false)
  tokenVerificacion       String?   @unique
  tokenExpira             DateTime?
  onboardingCompletado    Boolean   @default(false)
  terminosAceptados       Boolean   @default(false)
  fechaAceptacionTerminos DateTime?
  puedeCrearPrestamos     Boolean   @default(false)
  puedeGestionarPrestamos Boolean   @default(false)
  puedeCrearClientes      Boolean   @default(false)
  puedeEditarClientes     Boolean   @default(false)
  puedeReportarGastos     Boolean   @default(true)
  puedeVerCapital         Boolean   @default(false)
  puedeVerCapitalRuta     Boolean   @default(false) // ver capital/caja SOLO de su(s) ruta(s)
  puedeVerSaldoCaja       Boolean   @default(false)
  puedeGestionarRutas     Boolean   @default(false)
  puedeAplicarDescuentos  Boolean   @default(false) // aplicar descuentos y liquidaciones (riesgo: reduce saldo)
  puedeDesembolsarLinea Boolean @default(false)
  puedeReabrirCajaSinAprobacion Boolean @default(false) // reabrir su propia caja cerrada sin esperar aprobacion del owner
  orden                   Int       @default(0) // orden manual del cobrador (drag-and-drop en la lista)
  emailsMarketing         Boolean   @default(true)
  theme                   String?   @default("system")
  avatarId                String?
  createdAt               DateTime  @default(now())
  lastLoginAt             DateTime?
  lastActivityAt          DateTime?
  latitud                 Float?
  longitud                Float?
  ubicacionUpdatedAt      DateTime?

  organization      Organization?      @relation(fields: [organizationId], references: [id])
  rutas             Ruta[]             @relation("CobradorRuta")
  pagos             Pago[]
  cierresCaja       CierreCaja[]
  reaperturasCaja   CierreCaja[]       @relation("ReaperturaCierreCaja")
  solicitudesReaperturaCaja CierreCaja[] @relation("SolicitudReaperturaCierreCaja")
  adminLogs         AdminLog[]         @relation("AdminLogs")
  gastosMenores     GastoMenor[]       @relation("CobradorGastos")
  tickets           TicketSoporte[]
  mensajesTicket    MensajeTicket[]
  notasAdmin        NotaSeguimiento[]  @relation("NotasAdmin")
  actividadLogs     ActividadLog[]
  pushSubscriptions PushSubscription[]
  asistenteMemorias AsistenteMemoria[]
  fotosDonadas      FotoDonada[]
  clientesCreadosPor Cliente[]         @relation("ClientesCreadosPor")
  notificaciones    Notificacion[]     @relation("NotificacionesUsuario")
  ubicacionLogs     UbicacionLog[]
  sesionesActivas   SesionActiva[]

  @@index([organizationId])
  @@index([organizationId, rol, activo])
}

model UbicacionLog {
  id        String   @id @default(cuid())
  userId    String
  latitud   Float
  longitud  Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  // Para la purga por antiguedad del cron de limpieza
  @@index([createdAt])
}

model Ruta {
  id             String   @id @default(cuid())
  organizationId String
  cobradorId     String?
  nombre         String
  activo         Boolean  @default(true)
  diasSinCobro   String?
  saldoCapital      Float    @default(0) // capital de la sub-bolsa de esta ruta (denormalizado)
  capitalHabilitado Boolean  @default(false)
  orden             Int      @default(0) // orden manual de la ruta (drag-and-drop en la lista)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  cobrador     User?        @relation("CobradorRuta", fields: [cobradorId], references: [id])
  clientes     Cliente[]

  @@index([organizationId])
  @@index([cobradorId])
  @@index([organizationId, activo])
}

model GrupoCobro {
  id             String   @id @default(cuid())
  organizationId String
  nombre         String
  color          String?
  orden          Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  clientes     Cliente[]

  @@index([organizationId])
}

model Festivo {
  id             String   @id @default(cuid())
  organizationId String
  fecha          DateTime
  nombre         String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, fecha])
  @@index([organizationId, fecha])
}

model Cliente {
  id             String        @id @default(cuid())
  organizationId String
  rutaId         String?
  grupoCobroId   String?
  ordenRuta      Int?
  nombre         String
  cedula         String
  telefono       String?
  direccion      String?
  referencia     String?       @db.VarChar(100)
  notas          String?       @db.Text
  fotoUrl        String?
  latitud        Float?
  longitud       Float?
  estado         EstadoCliente @default(activo)
  eliminadoEn    DateTime?
  diasSinCobro        String?
  montoMaximoPrestamo Float?
  creadoPorId         String?
  pinPortal           String?
  portalActivo        Boolean       @default(false)
  ultimoAccesoPortal  DateTime?
  camposRecibo        Json?
  createdAt           DateTime      @default(now())

  organization       Organization       @relation(fields: [organizationId], references: [id])
  ruta               Ruta?              @relation(fields: [rutaId], references: [id])
  grupoCobro         GrupoCobro?        @relation(fields: [grupoCobroId], references: [id], onDelete: SetNull)
  creadoPor          User?              @relation("ClientesCreadosPor", fields: [creadoPorId], references: [id])
  prestamos          Prestamo[]
  visitasReagendadas VisitaReagendada[]
  lineasCredito      LineaCredito[]

  @@unique([organizationId, cedula])
  @@index([organizationId])
  @@index([cedula])
  @@index([estado])
  @@index([grupoCobroId])
  @@index([rutaId])
  @@index([creadoPorId])
  @@index([organizationId, estado])
  @@index([organizationId, rutaId, estado])
}

model Prestamo {
  id             String         @id @default(cuid())
  clienteId      String
  organizationId String
  montoPrestado  Float
  tasaInteres    Float
  totalAPagar    Float
  cuotaDiaria    Float
  frecuencia     String         @default("diario")
  modoInteres    String         @default("fijo") // fijo | unico | saldo | manual | lineal | lineal_dinamico | solo_interes | proporcional (legacy). Default fijo: antes era 'proporcional' (legacy) y cualquier insert que omitiera el campo nacia legacy por accidente.
  nombreProducto String? // mercancia: nombre del articulo (gorra, reloj...). null en prestamos de dinero
  diaCobroSemana Int? // 0=dom..6=sab — ancla para frecuencia semanal/quincenal (opcional)
  diaCobroMes    Int? // 1..31 — ancla para frecuencia mensual/quincenal (opcional, clamp a ultimo dia)
  diaCobroMes2   Int? // 1..31 — segundo dia ancla para quincenal (ej: cobra el 5 y el 20)
  // Fecha del PRIMER cobro pactado. null = el calendario de siempre (fechaInicio
  // + N periodos, anclado al dia de corte). Se llena al crear cuando hay dia de
  // corte mensual, porque sin ella el primer periodo salia de cualquier tamano:
  // presta el 13 y cobra los 30 y la primera cuota se iba 48 dias despues. Es
  // nullable a proposito: los prestamos que ya existen la tienen en null y
  // conservan su calendario exacto.
  primerCobro    DateTime?
  diasSinCobro   String?
  fechaInicio    DateTime
  fechaFin       DateTime
  diasPlazo      Int
  /// PRÉSTAMO ABIERTO: se cobra solo el interés del período y el capital queda
  /// pendiente sin fecha de vencimiento. Solo tiene sentido con modoInteres
  /// 'solo_interes' y se valida en el API.
  ///
  /// Por defecto `false`: los 10.218 préstamos que ya existen nacen con el
  /// comportamiento de siempre, bit por bit, sin migrar un solo dato.
  ///
  /// `fechaFin` y `diasPlazo` se siguen guardando —son NOT NULL y los leen 79
  /// archivos— pero en un abierto NO deciden nada: son el primer período, y la
  /// pantalla enseña «Abierto» en vez de una fecha.
  sinPlazo       Boolean        @default(false)
  seguro         Boolean        @default(false)
  montoSeguro    Float?
  estado         EstadoPrestamo @default(activo)
  // Denormalizados desde Pago (mantenidos por lib/prisma-pago-helpers.js).
  // Evitan recalcular totales iterando todos los pagos en cada lectura.
  totalPagado    Float          @default(0)
  /// Lo abonado A CAPITAL, que está DENTRO de `totalPagado` y hay que poder
  /// restarlo.
  ///
  /// Un abono a capital no paga cuotas: baja el saldo y la tabla se rehace con
  /// cuotas más chicas. Pero la cascada que decide «hasta qué cuota llega lo
  /// pagado» sumaba `totalPagado` a secas, así que se comía las cuotas futuras
  /// una detrás de otra. Reportado por PRESTAMOS PEDRO el 14 ago 2026: David
  /// Popayán abonó $500.000 y la pantalla le dijo que el próximo cobro era el
  /// 27 de febrero de 2027 — los $500.000 repartidos como seis meses de
  /// interés por adelantado.
  ///
  /// ⚠ VA DENORMALIZADO A PROPÓSITO. La resta se podía hacer leyendo `pagos`,
  /// pero no todas las pantallas los cargan: `clientes/route.js` no los pide y
  /// `prestamos/route.js` trae solo los diez últimos. Con la lista de pagos, la
  /// misma deuda daba una fecha en la ficha y otra en el listado.
  abonadoCapital Float          @default(0)
  ultimoPagoAt   DateTime?
  creadoPorId    String? // id del User que creo el prestamo (auditoria)
  renovadoDeId   String? // id del prestamo del que proviene (si fue una renovacion)
  // Lo que este prestamo debia ANTES de que una renovacion lo absorbiera.
  // Renovar pisa totalAPagar con lo ya pagado para dejar el saldo en cero, y ese
  // numero era irrecuperable: si despues se quitaba la renovacion (cobrador que
  // renovo la cartulina equivocada) el saldo viejo se evaporaba y no habia como
  // reconstruirlo. Aqui se conserva para poder devolverlo. Null = nunca lo
  // renovaron, o ya se le devolvio.
  totalAPagarPrevio Float?
  // Tarjeta clavo: prestamo malo/incobrable. Se excluye de saldos/cartera/capital
  // normales y se lleva en contabilidad aparte. Sigue cobrable (pagos van aparte).
  proximoCobroManual DateTime? // override manual de la fecha de proximo cobro (null = automatico)
  firmaUrl       String? // ruta a la imagen PNG de la firma del cliente
  interesAdelantado Boolean     @default(false) // globo: interes se cobra adelantado, ultima cuota solo capital
  capitalExtra   Json? // [{numeroPeriodo, monto}] cuotas extra programadas
  esClavo        Boolean        @default(false)
  clavoAt        DateTime? // cuando se marco como clavo
  clavoPerdida   Boolean        @default(false) // si al marcarlo se registro el capital como perdida
  socioId        String? // socio responsable del prestamo (natillera)
  createdAt      DateTime       @default(now())

  cliente      Cliente      @relation(fields: [clienteId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  socio        Socio?       @relation(fields: [socioId], references: [id])
  pagos        Pago[]
  cuotasAmortizacion CuotaAmortizacion[]
  devengos           DevengoInteres[]

  @@index([organizationId])
  @@index([clienteId])
  @@index([socioId])
  @@index([estado])
  @@index([organizationId, estado])
  @@index([organizationId, clienteId, estado])
  @@index([createdAt])
  @@index([renovadoDeId])
  @@index([creadoPorId])
  @@index([organizationId, esClavo])
  @@index([estado, ultimoPagoAt])
}

// Tabla de amortizacion para prestamos en modoInteres = 'lineal', 'lineal_dinamico'
// o 'solo_interes' (cuota decreciente: capital constante por periodo + interes
// sobre saldo restante). En lineal_dinamico, la tabla se recalcula tras cada pago.
// Es la fuente de verdad para mora/saldo/desglose de estos modos, en vez del
// cuotaDiaria fijo que usan los demas modos.
/// EL INTERÉS YA DEVENGADO DE UN PRÉSTAMO ABIERTO.
///
/// Un apunte por préstamo y por período. Cuando el período cierra, su interés
/// SUBE LA DEUDA (`totalAPagar`), igual que un recargo — la mecánica que ya
/// existe y está probada— y aquí queda el rastro de por qué subió.
///
/// ⚠ LA CLAVE ÚNICA (prestamoId, periodo) ES LA DEFENSA, no una optimización.
/// Devengar dos veces es el fallo que mató a la línea de crédito: tras un corte
/// volvía a cobrar el mes entero. Con esta clave, correr el cron dos veces —o
/// dos ejecuciones a la vez— no puede cobrar dos veces ni aunque el código
/// falle.
model DevengoInteres {
  id             String   @id @default(cuid())
  prestamoId     String
  organizationId String
  /// El día en que cerró el período, 'YYYY-MM-DD' en hora del país.
  periodo        String
  /// El capital sobre el que se calculó. Se guarda para poder explicar la
  /// cifra meses después sin tener que reconstruir los abonos.
  capitalBase    Float
  interes        Float
  createdAt      DateTime @default(now())

  prestamo     Prestamo     @relation(fields: [prestamoId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([prestamoId, periodo])
  @@index([organizationId])
}

model CuotaAmortizacion {
  id            String   @id @default(cuid())
  prestamoId    String
  prestamo      Prestamo @relation(fields: [prestamoId], references: [id], onDelete: Cascade)
  numeroPeriodo Int
  capital       Float
  interes       Float
  cuotaTotal    Float
  saldoRestante Float
  pagado        Float    @default(0)
  interesPagado Float    @default(0)
  fechaEsperada DateTime

  @@unique([prestamoId, numeroPeriodo])
  @@index([prestamoId])
}

model Pago {
  id             String   @id @default(cuid())
  prestamoId     String
  organizationId String
  cobradorId     String?
  montoPagado    Float
  fechaPago      DateTime @default(now())
  tipo           TipoPago
  metodoPago     String?  // 'efectivo' | 'transferencia'
  plataforma     String?  // legacy: texto libre
  metodoPagoId   String?  // FK a MetodoPago (solo cuando metodoPago = 'transferencia')
  nota           String?
  cuotaNumero    Int?
  latitud        Float?
  longitud       Float?
  fotoUrl        String?
  createdAt      DateTime @default(now())

  prestamo       Prestamo      @relation(fields: [prestamoId], references: [id])
  organization   Organization  @relation(fields: [organizationId], references: [id])
  cobrador       User?         @relation(fields: [cobradorId], references: [id])
  metodoPagoRef  MetodoPago?   @relation(fields: [metodoPagoId], references: [id])

  // [organizationId] y [prestamoId] sueltos se quitaron: son prefijo por la
  // izquierda de los compuestos de abajo, asi que MySQL ya los cubre. Eran
  // trabajo extra en cada insert de la tabla con mas escrituras del sistema.
  @@index([organizationId, fechaPago])
  @@index([prestamoId, fechaPago])
  @@index([createdAt])
  @@index([organizationId, cobradorId, fechaPago])
}

model MetodoPago {
  id               String   @id @default(cuid())
  organizationId   String
  nombre           String
  orden            Int      @default(0)
  activo           Boolean  @default(true)
  esPredeterminado Boolean  @default(false)
  // ── ¿A QUIÉN LE LLEGA LA PLATA QUE ENTRA POR AQUÍ? ──────────────────────
  //
  // false (lo normal) = es una cuenta del NEGOCIO. El cobrador no la toca, así
  //   que lo que entre aquí no va en el fajo que entrega en la noche.
  // true = es la cuenta DEL COBRADOR. Él recibe la plata y después se la pasa
  //   al negocio, así que sí la debe entregar y sí cuenta en su caja.
  //
  // Hasta ahora el sistema daba por hecho lo primero para todos, y ese supuesto
  // solo estaba escrito en un comentario, con la frase de PRESTA MIL: «cuando
  // llegan a entregar en la noche saben que ese dinero llegó a la cuenta de la
  // oficina y el resto lo traen en efectivo». Cierto para ellos, no para todos:
  // «puede que otros negocios trabaen distinto».
  //
  // ⚠ VA EN LA CUENTA, NO EN EL NEGOCIO. Un mismo negocio puede tener el Nequi
  //   de la oficina Y el Daviplata del cobrador de la ruta 3.
  esDelCobrador    Boolean  @default(false)
  createdAt        DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  pagos        Pago[]

  @@unique([organizationId, nombre])
  @@index([organizationId, activo])
}

model CierreCaja {
  id                 String    @id @default(cuid())
  organizationId     String
  cobradorId         String
  fecha              DateTime
  totalEsperado      Float
  totalRecogido      Float
  totalGastos        Float     @default(0)
  totalDesembolsado  Float     @default(0)
  saldoOperativo     Float     @default(0)
  saldoRealCaja      Float     @default(0)
  diferencia         Float
  createdAt          DateTime  @default(now())
  editadoEn          DateTime? // se setea al editar/ajustar un cierre ya creado
  editadoPorId       String? // quien hizo la ultima edicion (owner o cobrador)
  // Cuadre del dia: el admin confirma el efectivo fisico que recibio de este cobrador.
  efectivoRecibido   Float? // lo que el admin conto/recibio en mano
  diferenciaRecibido Float? // efectivoRecibido - totalRecogido(sistema): faltante/sobrante
  confirmadoEn       DateTime? // cuando el admin confirmo la recepcion
  confirmadoPorId    String? // quien confirmo (auditoria)
  notaCuadre         String? // motivo cuando hay diferencia
  // Reapertura: mientras la caja esta cerrada (sin reabiertoEn), el cobrador
  // no puede registrar nuevos pagos. Reabrir deja rastro de quien y cuando.
  reabiertoEn        DateTime?
  reabiertoPorId     String?
  // Solicitud de reapertura: cobradores sin permiso de reabrir directo piden
  // aprobacion al owner. Mientras este pendiente (sin reabiertoEn), la caja sigue cerrada.
  solicitudReaperturaEn   DateTime?
  solicitudReaperturaPorId String?

  organization Organization @relation(fields: [organizationId], references: [id])
  cobrador     User         @relation(fields: [cobradorId], references: [id])
  reabiertoPor User?        @relation("ReaperturaCierreCaja", fields: [reabiertoPorId], references: [id])
  solicitudReaperturaPor User? @relation("SolicitudReaperturaCierreCaja", fields: [solicitudReaperturaPorId], references: [id])

  @@index([organizationId])
  @@index([organizationId, fecha])
  @@index([cobradorId, fecha])
}

model Suscripcion {
