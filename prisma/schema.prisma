// Control Finanzas - Schema de Prisma
// SaaS multi-tenant para gestión de cartera de crédito informal

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

generator clientLegacy {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─── ENUMS ───────────────────────────────────────────────

enum Plan {
  test
  starter
  basic
  growth
  standard
  professional
}

enum Rol {
  owner
  cobrador
  superadmin
}

enum EstadoCliente {
  activo
  mora
  cancelado
  inactivo
  eliminado
}

enum EstadoPrestamo {
  pendiente_aprobacion
  activo
  completado
  cancelado
}

enum TipoPago {
  completo
  parcial
  capital
  recargo
  descuento
  liquidacion
  intereses
}

enum EstadoSuscripcion {
  activa
  vencida
  cancelada
  pendiente
}

enum TipoSuscripcion {
  pago_unico
  recurrente
}

// ─── MODELOS ─────────────────────────────────────────────

model Organization {
  id                String         @id @default(cuid())
  nombre            String
  plan              Plan           @default(basic)
  telefono          String?
  ciudad            String?
  activo            Boolean        @default(true)
  codigoReferido    String?        @unique
  referidoPorId     String?
  descuento         Int            @default(0)
  cobradoresExtra   Int            @default(0)
  rutasExtra        Int            @default(0)
  estadoContacto    EstadoContacto @default(nuevo)
  fuenteRegistro    String?
  planOriginal      Plan?
  planDemoHasta     DateTime?
  onboardingStep    Int            @default(0)
  onboardingFlujo   String?
  trialReminderSent Boolean        @default(false)
  recoveryEmailStep Int            @default(0)
  waRecoverySent    Boolean        @default(false)
  diasSinCobro      String?
  capitalEstricto   Boolean        @default(false)
  capitalEsEfectivo Boolean        @default(false)
  modoAbreviado     Boolean        @default(false)
  ocultarSaldoWA    Boolean        @default(false)
  requiereAprobacionPrestamos Boolean @default(false)
  ocultarCapitalCobradores    Boolean @default(false)
  tasaMoratorio     Float          @default(0)
  diasGraciaMoratorio Int          @default(5)
  country           String         @default("co")
  timezone          String?
  cartulinasHoy     Int            @default(0)
  cartulinasFecha   DateTime?
  createdAt         DateTime       @default(now())

  referidoPor        Organization?       @relation("Referidos", fields: [referidoPorId], references: [id])
  referidos          Organization[]      @relation("Referidos")
  users              User[]
  rutas              Ruta[]
  clientes           Cliente[]
  prestamos          Prestamo[]
  pagos              Pago[]
  cierresCaja        CierreCaja[]
  suscripciones      Suscripcion[]
  asistenteMemorias  AsistenteMemoria[]
  adminLogs          AdminLog[]
  gastosMenores      GastoMenor[]
  tickets            TicketSoporte[]
  notasSeguimiento   NotaSeguimiento[]
  leads              Lead[]
  botLeads           BotLead[]
  capital            Capital?
  movimientosCapital MovimientoCapital[]
  actividadLogs      ActividadLog[]
  gruposCobro        GrupoCobro[]
  festivos           Festivo[]
  visitasReagendadas VisitaReagendada[]
  lineasCredito      LineaCredito[]
  desembolsosLinea   DesembolsoLinea[]
  pagosLinea         PagoLinea[]
  cortesLinea        CorteLinea[]
  notificaciones     Notificacion[]
  socios             Socio[]
  aportesSocios      AporteSocio[]

  @@index([createdAt])
}

model User {
  id                      String    @id @default(cuid())
  organizationId          String?
  nombre                  String
  email                   String    @unique
  telefono                String?
  password                String
  rol                     Rol
  activo                  Boolean   @default(true)
  emailVerificado         Boolean   @default(false)
  tokenVerificacion       String?   @unique
  tokenExpira             DateTime?
  onboardingCompletado    Boolean   @default(false)
  terminosAceptados       Boolean   @default(false)
  fechaAceptacionTerminos DateTime?
  puedeCrearPrestamos     Boolean   @default(false)
  puedeGestionarPrestamos Boolean   @default(false)
  puedeCrearClientes      Boolean   @default(false)
  puedeEditarClientes     Boolean   @default(false)
  puedeReportarGastos     Boolean   @default(true)
  puedeVerCapital         Boolean   @default(false)
  puedeVerCapitalRuta     Boolean   @default(false) // ver capital/caja SOLO de su(s) ruta(s)
  puedeVerSaldoCaja       Boolean   @default(false)
  puedeGestionarRutas     Boolean   @default(false)
  puedeAplicarDescuentos  Boolean   @default(false) // aplicar descuentos y liquidaciones (riesgo: reduce saldo)
  puedeDesembolsarLinea Boolean @default(false)
  puedeReabrirCajaSinAprobacion Boolean @default(false) // reabrir su propia caja cerrada sin esperar aprobacion del owner
  orden                   Int       @default(0) // orden manual del cobrador (drag-and-drop en la lista)
  emailsMarketing         Boolean   @default(true)
  theme                   String?   @default("system")
  avatarId                String?
  createdAt               DateTime  @default(now())
  lastLoginAt             DateTime?
  lastActivityAt          DateTime?
  latitud                 Float?
  longitud                Float?
  ubicacionUpdatedAt      DateTime?

  organization      Organization?      @relation(fields: [organizationId], references: [id])
  rutas             Ruta[]             @relation("CobradorRuta")
  pagos             Pago[]
  cierresCaja       CierreCaja[]
  reaperturasCaja   CierreCaja[]       @relation("ReaperturaCierreCaja")
  solicitudesReaperturaCaja CierreCaja[] @relation("SolicitudReaperturaCierreCaja")
  adminLogs         AdminLog[]         @relation("AdminLogs")
  gastosMenores     GastoMenor[]       @relation("CobradorGastos")
  tickets           TicketSoporte[]
  mensajesTicket    MensajeTicket[]
  notasAdmin        NotaSeguimiento[]  @relation("NotasAdmin")
  actividadLogs     ActividadLog[]
  pushSubscriptions PushSubscription[]
  asistenteMemorias AsistenteMemoria[]
  clientesCreadosPor Cliente[]         @relation("ClientesCreadosPor")
  notificaciones    Notificacion[]     @relation("NotificacionesUsuario")
  ubicacionLogs     UbicacionLog[]

  @@index([organizationId])
  @@index([organizationId, rol, activo])
}

model UbicacionLog {
  id        String   @id @default(cuid())
  userId    String
  latitud   Float
  longitud  Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Ruta {
  id             String   @id @default(cuid())
  organizationId String
  cobradorId     String?
  nombre         String
  activo         Boolean  @default(true)
  diasSinCobro   String?
  saldoCapital      Float    @default(0) // capital de la sub-bolsa de esta ruta (denormalizado)
  capitalHabilitado Boolean  @default(false)
  orden             Int      @default(0) // orden manual de la ruta (drag-and-drop en la lista)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  cobrador     User?        @relation("CobradorRuta", fields: [cobradorId], references: [id])
  clientes     Cliente[]

  @@index([organizationId])
  @@index([cobradorId])
  @@index([organizationId, activo])
}

model GrupoCobro {
  id             String   @id @default(cuid())
  organizationId String
  nombre         String
  color          String?
  orden          Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  clientes     Cliente[]

  @@index([organizationId])
}

model Festivo {
  id             String   @id @default(cuid())
  organizationId String
  fecha          DateTime
  nombre         String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, fecha])
  @@index([organizationId, fecha])
}

model Cliente {
  id             String        @id @default(cuid())
  organizationId String
  rutaId         String?
  grupoCobroId   String?
  ordenRuta      Int?
  nombre         String
  cedula         String
  telefono       String?
  direccion      String?
  referencia     String?       @db.VarChar(100)
  notas          String?       @db.Text
  fotoUrl        String?
  latitud        Float?
  longitud       Float?
  estado         EstadoCliente @default(activo)
  eliminadoEn    DateTime?
  diasSinCobro        String?
  montoMaximoPrestamo Float?
  creadoPorId         String?
  createdAt           DateTime      @default(now())

  organization       Organization       @relation(fields: [organizationId], references: [id])
  ruta               Ruta?              @relation(fields: [rutaId], references: [id])
  grupoCobro         GrupoCobro?        @relation(fields: [grupoCobroId], references: [id], onDelete: SetNull)
  creadoPor          User?              @relation("ClientesCreadosPor", fields: [creadoPorId], references: [id])
  prestamos          Prestamo[]
  visitasReagendadas VisitaReagendada[]
  lineasCredito      LineaCredito[]

  @@unique([organizationId, cedula])
  @@index([organizationId])
  @@index([cedula])
  @@index([estado])
  @@index([grupoCobroId])
  @@index([rutaId])
  @@index([creadoPorId])
  @@index([organizationId, estado])
  @@index([organizationId, rutaId, estado])
}

model Prestamo {
  id             String         @id @default(cuid())
  clienteId      String
  organizationId String
  montoPrestado  Float
  tasaInteres    Float
  totalAPagar    Float
  cuotaDiaria    Float
  frecuencia     String         @default("diario")
  modoInteres    String         @default("proporcional") // fijo | unico | saldo | manual | lineal | lineal_dinamico | proporcional (legacy)
  nombreProducto String? // mercancia: nombre del articulo (gorra, reloj...). null en prestamos de dinero
  diaCobroSemana Int? // 0=dom..6=sab — ancla para frecuencia semanal/quincenal (opcional)
  diaCobroMes    Int? // 1..31 — ancla para frecuencia mensual/quincenal (opcional, clamp a ultimo dia)
  diaCobroMes2   Int? // 1..31 — segundo dia ancla para quincenal (ej: cobra el 5 y el 20)
  diasSinCobro   String?
  fechaInicio    DateTime
  fechaFin       DateTime
  diasPlazo      Int
  seguro         Boolean        @default(false)
  montoSeguro    Float?
  estado         EstadoPrestamo @default(activo)
  // Denormalizados desde Pago (mantenidos por lib/prisma-pago-helpers.js).
  // Evitan recalcular totales iterando todos los pagos en cada lectura.
  totalPagado    Float          @default(0)
  ultimoPagoAt   DateTime?
  creadoPorId    String? // id del User que creo el prestamo (auditoria)
  renovadoDeId   String? // id del prestamo del que proviene (si fue una renovacion)
  // Tarjeta clavo: prestamo malo/incobrable. Se excluye de saldos/cartera/capital
  // normales y se lleva en contabilidad aparte. Sigue cobrable (pagos van aparte).
  proximoCobroManual DateTime? // override manual de la fecha de proximo cobro (null = automatico)
  firmaUrl       String? // ruta a la imagen PNG de la firma del cliente
  interesAdelantado Boolean     @default(false) // globo: interes se cobra adelantado, ultima cuota solo capital
  capitalExtra   Json? // [{numeroPeriodo, monto}] cuotas extra programadas
  esClavo        Boolean        @default(false)
  clavoAt        DateTime? // cuando se marco como clavo
  clavoPerdida   Boolean        @default(false) // si al marcarlo se registro el capital como perdida
  socioId        String? // socio responsable del prestamo (natillera)
  createdAt      DateTime       @default(now())

  cliente      Cliente      @relation(fields: [clienteId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  socio        Socio?       @relation(fields: [socioId], references: [id])
  pagos        Pago[]
  cuotasAmortizacion CuotaAmortizacion[]

  @@index([organizationId])
  @@index([clienteId])
  @@index([socioId])
  @@index([estado])
  @@index([organizationId, estado])
  @@index([organizationId, clienteId, estado])
  @@index([createdAt])
  @@index([renovadoDeId])
  @@index([creadoPorId])
  @@index([organizationId, esClavo])
  @@index([estado, ultimoPagoAt])
}

// Tabla de amortizacion para prestamos en modoInteres = 'lineal', 'lineal_dinamico'
// o 'solo_interes' (cuota decreciente: capital constante por periodo + interes
// sobre saldo restante). En lineal_dinamico, la tabla se recalcula tras cada pago.
// Es la fuente de verdad para mora/saldo/desglose de estos modos, en vez del
// cuotaDiaria fijo que usan los demas modos.
model CuotaAmortizacion {
  id            String   @id @default(cuid())
  prestamoId    String
  prestamo      Prestamo @relation(fields: [prestamoId], references: [id], onDelete: Cascade)
  numeroPeriodo Int
  capital       Float
  interes       Float
  cuotaTotal    Float
  saldoRestante Float
  pagado        Float    @default(0)
  interesPagado Float    @default(0)
  fechaEsperada DateTime

  @@unique([prestamoId, numeroPeriodo])
  @@index([prestamoId])
}

model Pago {
  id             String   @id @default(cuid())
  prestamoId     String
  organizationId String
  cobradorId     String?
  montoPagado    Float
  fechaPago      DateTime @default(now())
  tipo           TipoPago
  metodoPago     String? // 'efectivo' | 'transferencia'
  plataforma     String? // Nequi, Daviplata, Bancolombia, etc. (texto libre)
  nota           String?
  cuotaNumero    Int?
  latitud        Float?
  longitud       Float?
  fotoUrl        String?
  createdAt      DateTime @default(now())

  prestamo     Prestamo     @relation(fields: [prestamoId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  cobrador     User?        @relation(fields: [cobradorId], references: [id])

  @@index([organizationId])
  @@index([prestamoId])
  @@index([organizationId, fechaPago])
  @@index([prestamoId, fechaPago])
  @@index([organizationId, cobradorId, fechaPago])
}

model CierreCaja {
  id                 String    @id @default(cuid())
  organizationId     String
  cobradorId         String
  fecha              DateTime
  totalEsperado      Float
  totalRecogido      Float
  totalGastos        Float     @default(0)
  totalDesembolsado  Float     @default(0)
  saldoOperativo     Float     @default(0)
  saldoRealCaja      Float     @default(0)
  diferencia         Float
  createdAt          DateTime  @default(now())
  editadoEn          DateTime? // se setea al editar/ajustar un cierre ya creado
  editadoPorId       String? // quien hizo la ultima edicion (owner o cobrador)
  // Cuadre del dia: el admin confirma el efectivo fisico que recibio de este cobrador.
  efectivoRecibido   Float? // lo que el admin conto/recibio en mano
  diferenciaRecibido Float? // efectivoRecibido - totalRecogido(sistema): faltante/sobrante
  confirmadoEn       DateTime? // cuando el admin confirmo la recepcion
  confirmadoPorId    String? // quien confirmo (auditoria)
  notaCuadre         String? // motivo cuando hay diferencia
  // Reapertura: mientras la caja esta cerrada (sin reabiertoEn), el cobrador
  // no puede registrar nuevos pagos. Reabrir deja rastro de quien y cuando.
  reabiertoEn        DateTime?
  reabiertoPorId     String?
  // Solicitud de reapertura: cobradores sin permiso de reabrir directo piden
  // aprobacion al owner. Mientras este pendiente (sin reabiertoEn), la caja sigue cerrada.
  solicitudReaperturaEn   DateTime?
  solicitudReaperturaPorId String?

  organization Organization @relation(fields: [organizationId], references: [id])
  cobrador     User         @relation(fields: [cobradorId], references: [id])
  reabiertoPor User?        @relation("ReaperturaCierreCaja", fields: [reabiertoPorId], references: [id])
  solicitudReaperturaPor User? @relation("SolicitudReaperturaCierreCaja", fields: [solicitudReaperturaPorId], references: [id])

  @@index([organizationId])
  @@index([organizationId, fecha])
  @@index([cobradorId, fecha])
}

model Suscripcion {
  id               String            @id @default(cuid())
  organizationId   String
  plan             Plan
  estado           EstadoSuscripcion @default(activa)
  fechaInicio      DateTime
  fechaVencimiento DateTime
  montoCOP         Int
  mercadopagoId    String?

  // Suscripción recurrente (MercadoPago PreApproval)
  tipo              TipoSuscripcion @default(pago_unico)
  preapprovalId     String?         @unique
  mpStatus          String? // pending, authorized, paused, cancelled
  frecuenciaMeses   Int             @default(1)
  ultimoCobroAt     DateTime?
  proximoCobroAt    DateTime?
  canceladaAt       DateTime?
  motivoCancelacion String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([tipo, estado])
}

model GastoMenor {
  id             String      @id @default(cuid())
  description    String
  monto          Float
  fecha          DateTime    @default(now())
  estado         GastoEstado @default(pendiente)
  cobradorId     String?
  organizationId String

  cobrador     User?        @relation("CobradorGastos", fields: [cobradorId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([cobradorId])
  @@index([organizationId, fecha])
}

enum GastoEstado {
  pendiente
  aprobado
  rechazado
}

enum TipoMovimiento {
  capital_inicial
  inyeccion
  retiro
  desembolso
  recaudo
  gasto
  ajuste
}

model Capital {
  id             String   @id @default(cuid())
  organizationId String   @unique
  saldo          Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id])
  movimientos  MovimientoCapital[]
}

model MovimientoCapital {
  id                 String         @id @default(cuid())
  capitalId          String
  organizationId     String
  tipo               TipoMovimiento
  monto              Float
  saldoAnterior      Float
  saldoNuevo         Float
  descripcion        String?
  referenciaId       String?
  referenciaTipo     String?
  rutaId             String? // ruta a la que pertenece el movimiento (null = general)
  ajusteArranqueRuta Boolean        @default(false) // ajuste que solo afecta la sub-bolsa de la ruta, NO el saldo global (absorber prestamos previos)
  creadoPorId        String?
  createdAt          DateTime       @default(now())

  capital      Capital      @relation(fields: [capitalId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([organizationId, rutaId, createdAt])
  @@index([capitalId])
  @@index([referenciaId])
}

enum EstadoContacto {
  nuevo
  contactado
  interesado
  activo_pagado
  perdido
}

model AdminLog {
  id             String   @id @default(cuid())
  adminId        String
  accion         String
  organizacionId String?
  detalle        String?
  createdAt      DateTime @default(now())

  admin        User          @relation("AdminLogs", fields: [adminId], references: [id])
  organizacion Organization? @relation(fields: [organizacionId], references: [id])

  @@index([adminId])
}

// ─── ACTIVIDAD / AUDIT LOG ─────────────────────────────────

model ActividadLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  accion         String // crear_prestamo, registrar_pago, crear_cliente, etc.
  entidadTipo    String // prestamo, pago, cliente, ruta, gasto, caja, capital
  entidadId      String?
  detalle        String?  @db.Text
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([userId])
}

// ─── MEMORIA DEL ASISTENTE ─────────────────────────────

model AsistenteMemoria {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  contenido      String   @db.Text
  categoria      String // preferencia | portafolio | comportamiento | accion
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@index([organizationId, categoria])
}

// ─── EVENTOS / ANALYTICS ───────────────────────────────

model Evento {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  evento         String // page_view, feature_click, api_call
  pagina         String? // /dashboard, /prestamos, etc.
  metadata       String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([organizationId, createdAt])
  @@index([evento, createdAt])
}

// ─── PUSH NOTIFICATIONS ────────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @db.Text
  p256dh    String   @db.Text
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── SOPORTE ─────────────────────────────────────────────

enum TipoTicket {
  bug
  pregunta
  solicitud
  problema_pago
  otro
}

enum EstadoTicket {
  abierto
  en_progreso
  resuelto
  cerrado
}

model TicketSoporte {
  id               String       @id @default(cuid())
  organizationId   String
  userId           String
  tipo             TipoTicket
  asunto           String
  descripcion      String       @db.Text
  estado           EstadoTicket @default(abierto)
  solicitaContacto Boolean      @default(false)
  telefonoContacto String?
  contactoAtendido Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id])
  user         User            @relation(fields: [userId], references: [id])
  mensajes     MensajeTicket[]

  @@index([organizationId])
  @@index([estado])
  @@index([userId])
}

model MensajeTicket {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String
  contenido String   @db.Text
  imagenUrl String?
  esAdmin   Boolean  @default(false)
  leido     Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket TicketSoporte @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id])

  @@index([ticketId])
}

// ─── CRM ─────────────────────────────────────────────────

model NotaSeguimiento {
  id             String          @id @default(cuid())
  organizationId String
  adminId        String
  contenido      String          @db.Text
  estadoContacto EstadoContacto?
  createdAt      DateTime        @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  admin        User         @relation("NotasAdmin", fields: [adminId], references: [id])

  @@index([organizationId])
}

// ─── LEADS ──────────────────────────────────────────────

model Lead {
  id                    String    @id @default(cuid())
  nombre                String
  telefono              String
  leadgenId             String?   @unique
  cantClientes          String?
  anuncioId             String?
  estado                String    @default("nuevo")
  notas                 String?   @db.Text
  organizationId        String?
  mensajesEnviados      String?   @db.Text
  ultimoRecordatorio    DateTime?
  recordatoriosEnviados Int       @default(0)
  telegramMessageId     Int?
  esPrestamista         String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])
  botLeads     BotLead[]

  @@index([createdAt])
  @@index([estado])
  @@index([telefono])
}

// ─── WHATSAPP BOT (Sales Agent) ─────────────────────────

enum BotLeadEstado {
  pendiente
  contactado
  interesado
  no_interesado
  cerrado
  bloqueado
  registrado
}

model BotLead {
  id                  String        @id @default(cuid())
  cfLeadId            String?
  organizationId      String?
  nombre              String
  telefono            String
  cantClientes        String?
  esPrestamista       String?
  metodoActual        String?
  planInteres         String?
  anuncioId           String?
  estado              BotLeadEstado @default(pendiente)
  temperatura         Int           @default(0)
  botActivo           Boolean       @default(true)
  alertado            Boolean       @default(false)
  hookId              String?
  intentosSeguimiento Int           @default(0)
  proximoSeguimiento  DateTime?
  fechaContacto       DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  cfLead         Lead?             @relation(fields: [cfLeadId], references: [id])
  organization   Organization?     @relation(fields: [organizationId], references: [id])
  conversaciones BotConversacion[]

  @@unique([telefono])
  @@index([estado])
  @@index([cfLeadId])
  @@index([organizationId])
  @@index([estado, botActivo, proximoSeguimiento])
}

model BotConversacion {
  id              String    @id @default(cuid())
  botLeadId       String
  rol             String // "bot" | "lead" | "admin"
  texto           String    @db.Text
  tipoMensaje     String    @default("chat") // "chat" | "audio" | "image" | "document" | "call"
  messageId       String?   @unique
  mediaPath       String? // ruta relativa del archivo en disco del VPS (uploads/wa/...)
  mediaTipo       String? // "image" | "audio" | "document"
  mediaMime       String? // mimetype original (image/jpeg, audio/ogg, ...)
  mediaWamid      String? // id del media en Meta (opcional)
  wamid           String?   @unique // id del mensaje SALIENTE devuelto por Meta (rol bot/admin)
  estadoEntrega   String? // "enviado" | "entregado" | "leido" | "fallido" (ack de Meta via webhook statuses)
  estadoEntregaEn DateTime? // fecha del ultimo ack recibido
  errorEntrega    String?   @db.Text // detalle del error si estadoEntrega = "fallido"
  createdAt       DateTime  @default(now())

  botLead BotLead @relation(fields: [botLeadId], references: [id], onDelete: Cascade)

  @@index([botLeadId])
}

model BotGastoApi {
  id        String   @id @default(cuid())
  proveedor String
  modelo    String?
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  costoUsd  Float    @default(0)
  detalle   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([proveedor])
}

model BotConfig {
  id               String   @id @default(cuid())
  botActivo        Boolean  @default(true)
  modoPrueba       Boolean  @default(false)
  systemPrompt     String   @db.LongText
  modelo           String   @default("claude-sonnet-4-6")
  limiteDiario     Int      @default(25)
  delayMinMs       Int      @default(30000)
  delayMaxMs       Int      @default(60000)
  limiteGastoUsd   Float    @default(5.0)
  whatsappPersonal String?
  updatedAt        DateTime @updatedAt
}

model BotLeccion {
  id            String   @id @default(cuid())
  tipo          String   // objecion_perdida, error_info, patron, mejora_cierre
  leccion       String   @db.Text
  accion        String   @db.Text
  leadNombre    String?
  estado        String   @default("pendiente") // pendiente, aprobada, rechazada
  aplicada      Boolean  @default(false)
  telegramMsgId Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model VisitaReagendada {
  id             String  @id @default(cuid())
  organizationId String
  clienteId      String
  prestamoId     String?
  cobradorId     String?
  rutaId         String?

  fechaOriginal   DateTime
  fechaReagendada DateTime
  motivo          String // no_estaba, negocio_cerrado, no_tenia_dinero, pidio_plazo, otro
  motivoDetalle   String?  @db.Text
  estado          String   @default("pendiente") // pendiente, completada, vencida

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  cliente      Cliente      @relation(fields: [clienteId], references: [id])

  @@index([organizationId, clienteId])
  @@index([organizationId, fechaReagendada])
}

model PushLog {
  id             String   @id @default(cuid())
  organizationId String
  tipo           String   // celebracion, recordatorio, etc.
  clave          String   // dedup key (e.g. cierre-perfecto-userId-2026-06-17)
  titulo         String
  cuerpo         String   @db.Text
  createdAt      DateTime @default(now())

  @@index([organizationId, tipo, createdAt])
  @@index([organizationId, clave])
}

// ─── LÍNEAS DE CRÉDITO ROTATIVAS ────────────────────────

model LineaCredito {
  id              String   @id @default(cuid())
  clienteId       String
  organizationId  String
  cupoMaximo      Float
  tasaInteres     Float
  modoInteres     String   @default("fijo_mensual")
  diaCorte        Int      @default(30)
  pagoMinimoPct   Float    @default(0)
  estado          String   @default("activa")
  creadoPorId     String?
  notas           String?  @db.Text
  createdAt       DateTime @default(now())

  cliente      Cliente          @relation(fields: [clienteId], references: [id])
  organization Organization     @relation(fields: [organizationId], references: [id])
  desembolsos  DesembolsoLinea[]
  pagosLinea   PagoLinea[]
  cortesLinea  CorteLinea[]

  @@index([organizationId])
  @@index([clienteId])
  @@index([organizationId, estado])
}

model DesembolsoLinea {
  id              String   @id @default(cuid())
  lineaCreditoId  String
  organizationId  String
  monto           Float
  nota            String?
  registradoPorId String?
  createdAt       DateTime @default(now())

  lineaCredito LineaCredito  @relation(fields: [lineaCreditoId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])

  @@index([lineaCreditoId])
  @@index([organizationId, createdAt])
}

model PagoLinea {
  id              String   @id @default(cuid())
  lineaCreditoId  String
  organizationId  String
  corteLineaId    String?
  montoTotal      Float
  montoAInteres   Float
  montoACapital   Float
  metodoPago      String?
  cobradorId      String?
  latitud         Float?
  longitud        Float?
  nota            String?
  createdAt       DateTime @default(now())

  lineaCredito LineaCredito  @relation(fields: [lineaCreditoId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])
  corteLinea   CorteLinea?   @relation(fields: [corteLineaId], references: [id])

  @@index([lineaCreditoId])
  @@index([organizationId, createdAt])
}

model CorteLinea {
  id                 String   @id @default(cuid())
  lineaCreditoId     String
  organizationId     String
  periodo            String
  fechaCorte         DateTime
  saldoAnterior      Float
  totalDesembolsos   Float
  interesesGenerados Float
  totalCargos        Float
  totalPagado        Float
  saldoNuevo         Float
  pagoMinimo         Float
  createdAt          DateTime @default(now())

  lineaCredito LineaCredito  @relation(fields: [lineaCreditoId], references: [id])
  organization Organization  @relation(fields: [organizationId], references: [id])
  pagos        PagoLinea[]

  @@unique([lineaCreditoId, periodo])
  @@index([organizationId])
}

model Notificacion {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  tipo           String
  titulo         String
  mensaje        String   @db.Text
  datos          String?  @db.Text
  leida          Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  usuario      User         @relation("NotificacionesUsuario", fields: [userId], references: [id])

  @@index([userId, leida])
  @@index([organizationId, createdAt])
}

model Socio {
  id             String   @id @default(cuid())
  organizationId String
  nombre         String
  cedula         String?
  telefono       String?
  notas          String?  @db.Text
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  aportes      AporteSocio[]
  prestamos    Prestamo[]

  @@unique([organizationId, cedula])
  @@index([organizationId])
}

model AporteSocio {
  id             String   @id @default(cuid())
  socioId        String
  organizationId String
  tipo           String   @default("aporte") // aporte | retiro
  monto          Float
  fecha          DateTime
  nota           String?
  createdAt      DateTime @default(now())

  socio        Socio        @relation(fields: [socioId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([socioId])
  @@index([organizationId])
}
